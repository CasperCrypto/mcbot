{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "McBot",
  "version": "0.4.0",
  "identifier": "dev.mcbot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && node scripts/build-engine.mjs && node scripts/stage-hermes.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "McBot",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "backgroundColor": "#151516",
        "trafficLightPosition": {
          "x": 18,
          "y": 23
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:5173 http://127.0.0.1:4317 ws://127.0.0.1:4317 http://*:4318 ws://*:4318 ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; frame-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mcbot-engine"
    ],
    "resources": {
      "../dist-hermes/hermes/": "hermes/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Draw a team of AI agents and run it.",
    "license": "MIT",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
